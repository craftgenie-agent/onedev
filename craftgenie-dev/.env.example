# CraftGenie OneDev local development — copy to .env and adjust if needed.
#
#     cp .env.example .env
#
# .env is gitignored. These are local-development credentials for a database
# bound to localhost; do not reuse them anywhere that is reachable off this machine.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_VERSION=17-alpine
POSTGRES_DB=onedev
POSTGRES_USER=onedev
POSTGRES_PASSWORD=onedev_dev_only
# 6432 rather than 5432: a host PostgreSQL install usually already holds 5432.
POSTGRES_PORT=6432

# --- pgAdmin ------------------------------------------------------------------
PGADMIN_VERSION=latest
PGADMIN_EMAIL=dev@craftgenie.local
PGADMIN_PASSWORD=pgadmin_dev_only
PGADMIN_PORT=6680

# --- OneDev first-run bootstrap -----------------------------------------------
# OneDev completes its setup wizard from these instead of prompting, so a fresh
# database comes up ready to use. They are read only while the root account does
# not yet exist; after that they are ignored.
ONEDEV_INITIAL_USER=admin
ONEDEV_INITIAL_PASSWORD=admin_dev_only
ONEDEV_INITIAL_EMAIL=admin@craftgenie.local
ONEDEV_SERVER_URL=http://localhost:6610

# --- CraftGenie provisioning (cg-provision.sh) --------------------------------
# The customer whose project pair is created: <group>/<name>-backend and <name>-ui.
CG_GROUP=craftgenie
CG_CUSTOMER=shop-manager
# Where OneDev should POST issue/PR events. Point this at the CraftGenie dispatcher
# in front of the Agent Gateway. Leave blank to skip webhook provisioning.
CG_WEBHOOK_URL=
CG_WEBHOOK_SECRET=
